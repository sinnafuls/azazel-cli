		"@sveltejs/vite-plugin-svelte": "^6",
		"@tailwindcss/vite": "^4",
		"@testing-library/svelte": "^5.4.2",
		"@types/dompurify": "^3.0.5",
		"@types/node": "^26.6.6",
		"bits-ui": "^2.21.0",
		"clsx": "^2.1.1",
		"dompurify": "^3.4.18",
		"eslint": "^9",
		"eslint-plugin-svelte": "^3.24.1",
		"globals": "^17.14.0",
		"highlight.js": "^11.12.0",
		"jsdom": "^26",
		"json-schema-to-typescript": "^16.0.0",
		"marked": "^18.2.0",
		"prettier": "^3.10.1",
